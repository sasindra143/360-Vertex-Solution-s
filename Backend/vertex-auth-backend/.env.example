ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# MongoDB Atlas connection string for notes, note media, jobs, and AI prompt management.
# Jobs and prompts use the existing vertex_notes database and their own collections.
MONGODB_URI=
# Public HTTPS website origin used for canonical URLs in the published-jobs sitemap.
PUBLIC_SITE_URL=https://www.360vertexsolutions.com
# Include the exact deployed frontend origin when hosting frontend and API separately.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
# Set HOST=0.0.0.0 when the backend must accept connections from outside its machine.
HOST=127.0.0.1
